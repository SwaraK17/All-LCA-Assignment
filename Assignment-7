
import pandas as pd
import matplotlib.pyplot as plt

# Load the CSV dataset
df = pd.read_csv("sample_data_assignment_07.csv")

# Display the dataset
print("Dataset:")
print(df)

# Line Plot
plt.figure(figsize=(7, 4.5))
plt.plot(df["Student"], df["Python"], marker="o")
plt.title("Python Marks of Students")
plt.xlabel("Student")
plt.ylabel("Python Marks")
plt.grid(True)
plt.show()

# Bar Plot
plt.figure(figsize=(7, 4.5))
plt.bar(df["Student"], df["Maths"])
plt.title("Maths Marks of Students")
plt.xlabel("Student")
plt.ylabel("Maths Marks")
plt.show()

# Scatter Plot
plt.figure(figsize=(7, 4.5))
plt.scatter(df["Maths"], df["Python"], s=70)
plt.title("Maths vs Python Marks")
plt.xlabel("Maths Marks")
plt.ylabel("Python Marks")
plt.grid(True)
plt.show()

# Correlation Matrix
correlation = df[["Maths", "Python", "Attendance"]].corr()

print("Correlation Matrix:")
print(correlation)

# Heatmap using Matplotlib
plt.figure(figsize=(6.5, 5))
plt.imshow(correlation, cmap="Blues", vmin=-1, vmax=1)

plt.colorbar()

plt.xticks(range(len(correlation.columns)), correlation.columns)
plt.yticks(range(len(correlation.columns)), correlation.columns)

# Display values inside the boxes
for i in range(len(correlation.columns)):
    for j in range(len(correlation.columns)):
        plt.text(j, i, round(correlation.iloc[i, j], 2),
                 ha="center", va="center")

plt.title("Correlation Heatmap")
plt.show()


